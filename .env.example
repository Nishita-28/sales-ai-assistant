LLM_PROVIDER=openai
APP_MODE=development
ALLOW_CUSTOMER_FACING_OUTPUT=false
REQUIRE_SOURCES=true
CLAIM_GUARDRAIL_MODE=block
VECTOR_DB_PATH=./vector_store/chroma

# Required to unlock the Admin page in the Streamlit UI. No default --
# the app shows an explicit error if this isn't set, rather than
# silently accepting a guessable password.
ADMIN_PASSWORD=replace_with_a_real_admin_password

OPENAI_API_KEY=replace_with_company_approved_key
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
