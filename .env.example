LLM_PROVIDER=openai
APP_MODE=development
ALLOW_CUSTOMER_FACING_OUTPUT=false
REQUIRE_SOURCES=true
CLAIM_GUARDRAIL_MODE=block
VECTOR_DB_PATH=./vector_store/chroma

# Required to unlock the Admin page in the Streamlit UI. No default --
# the app shows an explicit error if this isn't set, rather than
# silently accepting a guessable password.
ADMIN_PASSWORD=replace_with_a_real_admin_password

OPENAI_API_KEY=replace_with_company_approved_key
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional. Documents, claims, deals, requirements, feedback, and sales
# aids are stored in local files/SQLite when this is unset (fine for
# local dev). Set it to a Neon (or any) Postgres connection string to
# persist that data instead -- required for Streamlit Community Cloud,
# since its filesystem is wiped on every redeploy. Use the pooled
# connection string (hostname contains "-pooler"), not the direct one.
# The local Chroma vector index itself always stays local -- it's
# rebuilt from Postgres automatically on cold start when this is set.
# DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
